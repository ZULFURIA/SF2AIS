#!/bin/bash
# Startup-Mac — Creates a LaunchAgent for the Sf2AiS Probe desktop app (macOS)
#
# This script installs a macOS LaunchAgent plist that launches the Sf2AiS Probe
# Electron app at login and runs it continuously in the background.
#
# Prerequisites:
#   - The Sf2AiS Probe app should be installed in /Applications (or specify path)
#   - The app should be a packaged .app bundle (e.g. Sf2AiS Probe.app)
#
# Usage:
#   ./Startup-Mac                        # Interactive: asks for confirmation
#   ./Startup-Mac --app-path /Applications/Sf2AiS\ Probe.app   # Custom install path
#   ./Startup-Mac --remove               # Remove the LaunchAgent
#

set -euo pipefail

# --- Defaults ---
APP_PATH="${APP_PATH:-/Applications/Sf2AiS Probe.app}"
PLIST_NAME="com.sf2ais.probe.plist"
PLIST_PATH="$HOME/Library/LaunchAgents/$PLIST_NAME"
REMOVE=false

# --- Parse arguments ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --remove)
            REMOVE=true
            shift
            ;;
        --app-path)
            APP_PATH="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1"
            echo "Usage: $0 [--app-path /path/to/Sf2AiS Probe.app] [--remove]"
            exit 1
            ;;
    esac
done

# --- Remove ---
if [ "$REMOVE" = true ]; then
    if [ -f "$PLIST_PATH" ]; then
        launchctl bootout "gui/$(id -u)/$PLIST_NAME" 2>/dev/null || true
        launchctl remove "$PLIST_NAME" 2>/dev/null || true
        rm -f "$PLIST_PATH"
        echo "OK: Removed LaunchAgent at $PLIST_PATH"
    else
        echo "No LaunchAgent found at $PLIST_PATH."
    fi
    exit 0
fi

# --- Validate ---
if [ ! -d "$APP_PATH" ]; then
    echo "ERROR: App not found at: $APP_PATH"
    echo "Install the app or specify --app-path."
    exit 1
fi

APP_EXECUTABLE="$APP_PATH/Contents/MacOS/Sf2AiS Probe"

if [ ! -f "$APP_EXECUTABLE" ]; then
    echo "ERROR: App executable not found at: $APP_EXECUTABLE"
    exit 1
fi

# --- Create plist ---
echo "Installing LaunchAgent for Sf2AiS Probe..."
mkdir -p "$HOME/Library/LaunchAgents"

cat > "$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sf2ais.probe</string>
    <key>ProgramArguments</key>
    <array>
        <string>$APP_EXECUTABLE</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>WorkingDirectory</key>
    <string>$APP_PATH</string>
</dict>
</plist>
EOF

# Load the agent
launchctl bootout "gui/$(id -u)/$PLIST_NAME" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH" 2>/dev/null || true

echo "OK: LaunchAgent installed at $PLIST_PATH"
echo "   App: $APP_PATH"
echo "   The probe will start at login and restart every 5 minutes (StartInterval)."
echo "   View logs:   log stream --predicate 'subsystem == \"com.sf2ais.probe\"'"
echo "   Stop it:     $0 --remove"
