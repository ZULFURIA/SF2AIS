# SF2AIS environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Runtime secrets are read from the environment with fallbacks to data/config.json.

# Path to the runtime config file (optional)
# CONFIG_PATH=./data/config.json

# Probe token issued by the gateway dashboard
SF2AIS_PROBE_TOKEN=

# DuckDNS dynamic-DNS settings (optional)
SF2AIS_DDNS_SUBDOMAIN=
SF2AIS_DDNS_TOKEN=

# Optional outbound HTTPS tunnel for CGNAT / no-port-forwarding networks.
# Create a remotely managed Cloudflare Tunnel and route its hostname to
# http://127.0.0.1:8000. The app passes this secret via TUNNEL_TOKEN (not argv).
SF2AIS_CLOUDFLARED_TOKEN=
# Optional full path if cloudflared is not on PATH.
# SF2AIS_CLOUDFLARED_BIN=C:\\Program Files\\cloudflared\\cloudflared.exe

# HTTPS reverse proxy: list only the IP addresses of trusted TLS proxies.
# If Caddy/nginx runs on the same machine, 127.0.0.1,::1 is typical.
SF2AIS_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Do not set this to 1 on an internet-facing server. It disables remote HTTPS enforcement.
SF2AIS_ALLOW_INSECURE_REMOTE=0

# Docker command runner image (must be built locally first)
SF2AIS_DOCKER_IMAGE=sf2ais-workbench:latest
