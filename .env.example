# SF2AIS environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Runtime secrets are read from the environment with fallbacks to data/config.json.

# Path to the runtime config file (optional)
# CONFIG_PATH=./data/config.json

# Probe token issued by the gateway dashboard (used by probe.py and the desktop app)
SF2AIS_PROBE_TOKEN=

# DuckDNS dynamic-DNS settings (optional — only if you use DuckDNS)
SF2AIS_DDNS_SUBDOMAIN=
SF2AIS_DDNS_TOKEN=
